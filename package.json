{
  "name": "party-map",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Track-first DJ planner with private Supabase plans and self-contained HTML builds",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm build:site && pnpm build:offline",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "build:offline": "node scripts/build-offline.mjs",
    "check:offline": "node scripts/check-offline.mjs dist/party-map.html",
    "test": "node --experimental-strip-types --test tests/*.test.ts scripts/offline.test.mjs",
    "test:e2e": "playwright test",
    "build:connected": "node scripts/build-offline.mjs --connected"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
